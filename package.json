{
  "name": "vite-plugin-pretty-css-modules",
  "version": "1.0.0",
  "description": "Use prettier generated class names in development, while applying minification in production.",
  "homepage": "https://github.com/amannn/vite-plugin-pretty-css-modules",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/es/index.mjs",
  "module": "./dist/es/index.mjs",
  "types": "./dist/es/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/es/index.d.ts",
      "default": "./dist/es/index.mjs"
    },
    "require": {
      "types": "./dist/cjs/index.d.cts",
      "default": "./dist/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "bunchee",
    "prepublish": "pnpm build"
  },
  "keywords": [],
  "author": "Jan Amann",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.1",
    "bunchee": "^6.9.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  }
}
